{
  "name": "@sleek-relay/website-extraction",
  "version": "0.1.0",
  "description": "Onboarding website-extraction scraper for Sleek Relay assisted self-service onboarding. Drafts business-profile facts from a supplied website URL; never activates a tenant.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "cheerio": "^1.0.0",
    "openai": "^4.104.0",
    "playwright": "^1.55.0",
    "robots-parser": "^3.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
